<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.ol.controller.CheckoutController" spacing="16" styleClass="checkout-root">
    <stylesheets><URL value="@checkout.css"/></stylesheets>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4"><Label text="Checkout de huésped" styleClass="page-title"/>
            <Label text="Cierra la estancia, calcula los cargos y genera la factura." styleClass="page-subtitle"/></VBox>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-panel">
        <Label text="ID de reserva" styleClass="field-label"/>
        <TextField fx:id="reservationIdField" promptText="Ej. 104" onAction="#lookupReservation" prefWidth="180"/>
        <Button text="Consultar reserva" onAction="#lookupReservation" styleClass="secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="checkoutButton" text="Confirmar checkout" onAction="#confirmCheckout" styleClass="primary-button"/>
    </HBox>
    <Label fx:id="feedbackLabel" styleClass="feedback" wrapText="true"/>
    <GridPane hgap="20" vgap="12" styleClass="booking-card">
        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
        <Label text="Huésped" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="summary-caption"/>
        <Label fx:id="guestLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="summary-value"/>
        <Label text="Habitación" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="summary-caption"/>
        <Label fx:id="roomLabel" text="—" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="summary-value"/>
        <Label text="Fechas" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="summary-caption"/>
        <Label fx:id="datesLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="summary-value"/>
        <Label text="Tarifa" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="summary-caption"/>
        <Label fx:id="rateLabel" text="—" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="summary-value"/>
        <Label text="Depósito" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="summary-caption"/>
        <Label fx:id="depositLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="summary-value"/>
    </GridPane>
    <Label text="Consumos de la estancia" styleClass="section-title"/>
    <TableView fx:id="consumptionTable" VBox.vgrow="ALWAYS" styleClass="data-table"/>
    <HBox alignment="CENTER_RIGHT" spacing="24" styleClass="totals-panel">
        <VBox spacing="4"><Label text="Noches" styleClass="summary-caption"/><Label fx:id="nightsLabel" text="—" styleClass="summary-value"/></VBox>
        <VBox spacing="4"><Label text="Hospedaje" styleClass="summary-caption"/><Label fx:id="staySubtotalLabel" text="—" styleClass="summary-value"/></VBox>
        <VBox spacing="4"><Label text="Consumos" styleClass="summary-caption"/><Label fx:id="consumptionSubtotalLabel" text="—" styleClass="summary-value"/></VBox>
        <VBox spacing="4"><Label text="Total a pagar" styleClass="summary-caption"/><Label fx:id="totalLabel" text="—" styleClass="total-value"/></VBox>
    </HBox>
    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
</VBox>
